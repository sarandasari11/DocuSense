# DocuSense Environment Configuration
DATABASE_URL=sqlite:///./docusense.db
STORAGE_DIR=./storage/documents

# Qdrant Vector DB
# Set QDRANT_USE_LOCAL_STORAGE=true to run embedded without Docker, or false to use Docker on localhost:6333
QDRANT_USE_LOCAL_STORAGE=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=./storage/qdrant
QDRANT_COLLECTION=docusense_chunks

# Models
MODEL_RUNTIME_MODE=deterministic
MODEL_PRELOAD=true
MODEL_LOAD_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Providers (OpenAI, Gemini, Ollama)
SESSION_SECRET=dev-only-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
AUTH_COOKIE_SECURE=false
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

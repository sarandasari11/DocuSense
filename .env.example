# Copy to .env and adjust for your environment.
APP_ENV=development
APP_NAME=DocuSense
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Development defaults. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./backend/docusense.db
STORAGE_DIR=./backend/storage/documents

# Containerized Qdrant for development, hosted Qdrant for production.
QDRANT_USE_LOCAL_STORAGE=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docusense_chunks

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

DEFAULT_LLM_PROVIDER=mock
LLM_MODEL_NAME=gemini-1.5-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RERANK_TOP_K=5
RRF_K=60

# Production example:
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql+psycopg://docusense:docusense_secret@localhost:5432/docusense_db
# QDRANT_USE_LOCAL_STORAGE=false
# QDRANT_URL=https://your-qdrant-host.example.com
# QDRANT_API_KEY=replace-me
# CORS_ORIGINS=https://your-frontend.example.com
